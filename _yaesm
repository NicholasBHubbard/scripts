#!/bin/bash

# Remote Yaesm wrapper for the "debserver" SSH host. When executed, it
# forwards Yaesm commands to the server; when sourced, it registers Bash
# completion using candidates generated by the server.
#
# To let bash-completion source this file automatically, create a symlink:
#
#   mkdir -p ~/.local/share/bash-completion/completions
#   ln -s ~/.local/bin/_yaesm ~/.local/share/bash-completion/completions/_yaesm

__complete_remote_yaesm()
{
    local current=${COMP_WORDS[COMP_CWORD]}
    local -a words=("${COMP_WORDS[@]:1:COMP_CWORD-1}")

    mapfile -t COMPREPLY < <(
        command _yaesm __complete "--current=$current" -- "${words[@]}"
    )
}

# Bash-completion sources this file.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
    complete -F __complete_remote_yaesm _yaesm
    return
fi

# Normal execution forwards the command to debserver.
remote_command='exec yaesm'
for argument in "$@"; do
    remote_command+=" '${argument//\'/\'\\\'\'}'"
done

exec ssh -T debserver "$remote_command"
